generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(EMPLOYEE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  employee     Employee?
}

model Employee {
  id                 String              @id @default(cuid())
  userId             String              @unique
  employeeNumber     String              @unique
  firstName          String
  lastName           String
  dateOfBirth        DateTime?
  hireDate           DateTime
  jobTitle           String
  department         String?
  managerId          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  attendances        Attendance[]
  contracts          Contract[]
  manager            Employee?           @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports      Employee[]          @relation("EmployeeManager")
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  payslips           Payslip[]
  timeOffAllocations TimeOffAllocation[]
  timeOffRequests    TimeOffRequest[]
}

model Contract {
  id                String           @id @default(cuid())
  employeeId        String
  contractType      ContractType     @default(FULL_TIME)
  status            ContractStatus   @default(ACTIVE)
  startDate         DateTime
  endDate           DateTime?
  wageCurrency      String           @default("USD")
  wageAmount        Decimal          @db.Decimal(12, 2)
  workingScheduleId String?
  salaryStructureId String?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryStructure   SalaryStructure? @relation(fields: [salaryStructureId], references: [id])
  workingSchedule   WorkingSchedule? @relation(fields: [workingScheduleId], references: [id])
}

model WorkingSchedule {
  id            String         @id @default(cuid())
  name          String         @unique
  hoursPerWeek  Float          @default(40)
  flexibleHours Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  contracts     Contract[]
  scheduleLines ScheduleLine[]
}

model ScheduleLine {
  id                String          @id @default(cuid())
  workingScheduleId String
  dayOfWeek         DayOfWeek
  timeFrom          String
  timeTo            String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  workingSchedule   WorkingSchedule @relation(fields: [workingScheduleId], references: [id], onDelete: Cascade)
}

model Attendance {
  id         String           @id @default(cuid())
  employeeId String
  date       DateTime         @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
}

model TimeOffType {
  id               String              @id @default(cuid())
  name             String              @unique
  code             String              @unique
  isPaid           Boolean             @default(true)
  maxDaysPerYear   Float?
  requiresApproval Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  allocations      TimeOffAllocation[]
  requests         TimeOffRequest[]
}

model TimeOffAllocation {
  id            String      @id @default(cuid())
  employeeId    String
  timeOffTypeId String
  year          Int
  daysAllocated Float
  daysUsed      Float       @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timeOffType   TimeOffType @relation(fields: [timeOffTypeId], references: [id])

  @@unique([employeeId, timeOffTypeId, year])
}

model TimeOffRequest {
  id            String        @id @default(cuid())
  employeeId    String
  timeOffTypeId String
  startDate     DateTime      @db.Date
  endDate       DateTime      @db.Date
  daysRequested Float
  status        TimeOffStatus @default(DRAFT)
  reason        String?
  approvedById  String?
  approvedAt    DateTime?
  refusalReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timeOffType   TimeOffType   @relation(fields: [timeOffTypeId], references: [id])
}

model SalaryStructure {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  contracts   Contract[]
  payslips    Payslip[]
  rules       SalaryRule[]
}

model SalaryRule {
  id                 String             @id @default(cuid())
  salaryStructureId  String
  name               String
  code               String
  category           SalaryRuleCategory @default(ALLOWANCE)
  sequence           Int                @default(0)
  amountFixed        Decimal?           @db.Decimal(12, 2)
  amountPercentage   Decimal?           @db.Decimal(5, 4)
  baseCode           String?
  appears_on_payslip Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  salaryStructure    SalaryStructure    @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@unique([salaryStructureId, code])
}

model Payrun {
  id          String      @id @default(cuid())
  name        String
  periodStart DateTime    @db.Date
  periodEnd   DateTime    @db.Date
  state       PayrunState @default(DRAFT)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  payslips    Payslip[]
}

model Payslip {
  id                String           @id @default(cuid())
  payrunId          String
  employeeId        String
  salaryStructureId String?
  periodStart       DateTime         @db.Date
  periodEnd         DateTime         @db.Date
  basicWage         Decimal          @db.Decimal(12, 2)
  grossWage         Decimal?         @db.Decimal(12, 2)
  netWage           Decimal?         @db.Decimal(12, 2)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  employee          Employee         @relation(fields: [employeeId], references: [id])
  payrun            Payrun           @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  salaryStructure   SalaryStructure? @relation(fields: [salaryStructureId], references: [id])
  lines             PayslipLine[]

  @@unique([payrunId, employeeId])
}

model PayslipLine {
  id        String             @id @default(cuid())
  payslipId String
  name      String
  code      String
  category  SalaryRuleCategory
  quantity  Float              @default(1)
  rate      Decimal            @db.Decimal(12, 2)
  amount    Decimal            @db.Decimal(12, 2)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  payslip   Payslip            @relation(fields: [payslipId], references: [id], onDelete: Cascade)
}

enum Role {
  EMPLOYEE
  HR_MANAGER
  HR_PAYROLL_USER
  HR_PAYROLL_ADMIN
  ADMIN
}

enum ContractType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

enum TimeOffStatus {
  DRAFT
  CONFIRMED
  VALIDATED
  REFUSED
}

enum SalaryRuleCategory {
  BASIC
  ALLOWANCE
  DEDUCTION
  GROSS
  NET
}

enum PayrunState {
  DRAFT
  DONE
  CANCELLED
}
