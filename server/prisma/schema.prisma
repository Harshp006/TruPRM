generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  role               Role      @default(EMPLOYEE)
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  employee           Employee?
}

model Employee {
  id                 String              @id @default(cuid())
  userId             String              @unique
  employeeNumber     String              @unique
  firstName          String
  lastName           String
  color              String?
  dateOfBirth        DateTime?
  hireDate           DateTime
  jobTitle           String
  department         String?
  bankAccount        String?
  bankName           String?
  bankIfsc           String?
  managerId          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  attendances        Attendance[]
  contracts          Contract[]
  manager            Employee?           @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports      Employee[]          @relation("EmployeeManager")
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  payslips           Payslip[]
  timeOffAllocations TimeOffAllocation[]
  timeOffRequests    TimeOffRequest[]
  compOffCredits     CompOffCredit[]
  timeOffLedgers     TimeOffLedger[]
}

model Contract {
  id                String           @id @default(cuid())
  employeeId        String
  contractType      ContractType     @default(FULL_TIME)
  status            ContractStatus   @default(ACTIVE)
  startDate         DateTime
  endDate           DateTime?
  wageCurrency      String           @default("USD")
  wageAmount        Decimal          @db.Decimal(12, 2)
  workingScheduleId String?
  salaryStructureId String?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryStructure   SalaryStructure? @relation(fields: [salaryStructureId], references: [id])
  workingSchedule   WorkingSchedule? @relation(fields: [workingScheduleId], references: [id])
}

model WorkingSchedule {
  id            String         @id @default(cuid())
  name          String         @unique
  hoursPerWeek  Float          @default(40)
  flexibleHours Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  contracts     Contract[]
  scheduleLines ScheduleLine[]
}

model ScheduleLine {
  id                String          @id @default(cuid())
  workingScheduleId String
  dayOfWeek         DayOfWeek
  timeFrom          String
  timeTo            String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  workingSchedule   WorkingSchedule @relation(fields: [workingScheduleId], references: [id], onDelete: Cascade)
}

model Attendance {
  id            String           @id @default(cuid())
  employeeId    String
  date          DateTime         @db.Date
  checkIn       DateTime?
  checkOut      DateTime?
  workedHours   Float?
  overtimeHours Float?           @default(0)
  status        AttendanceStatus @default(PRESENT)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  employee      Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  compOffCredits CompOffCredit[]

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([employeeId, date])
}

model TimeOffType {
  id                   String              @id @default(cuid())
  name                 String              @unique
  code                 String              @unique
  description          String?
  unit                 String              @default("DAYS")
  isPaid               Boolean             @default(true)
  requiresAllocation   Boolean             @default(true)
  maxDaysPerYear       Float?
  requiresApproval     Boolean             @default(true)
  allowEmployeeRequest Boolean             @default(true)
  isEarnedThroughWork  Boolean             @default(false)
  allowPartialDays     Boolean             @default(true)
  isSandwichLeave      Boolean             @default(false)
  allocationMethod     String              @default("MANUAL")
  allocationAmount     Float?              @default(0)
  carryForwardDays     Float?              @default(0)
  expiryDays           Int?
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  allocations          TimeOffAllocation[]
  requests             TimeOffRequest[]
  ledgers              TimeOffLedger[]
}

model TimeOffAllocation {
  id            String      @id @default(cuid())
  employeeId    String
  timeOffTypeId String
  year          Int
  daysAllocated Float
  daysUsed      Float       @default(0)
  remaining     Float       @default(0)
  validityFrom  DateTime?   @db.Date
  validityTo    DateTime?   @db.Date
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timeOffType   TimeOffType @relation(fields: [timeOffTypeId], references: [id])

  @@unique([employeeId, timeOffTypeId, year])
}

model TimeOffRequest {
  id            String        @id @default(cuid())
  employeeId    String
  timeOffTypeId String
  startDate     DateTime      @db.Date
  endDate       DateTime      @db.Date
  daysRequested Float
  status        TimeOffStatus @default(DRAFT)
  reason        String?
  approvedById  String?
  approvedAt    DateTime?
  refusalReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timeOffType   TimeOffType   @relation(fields: [timeOffTypeId], references: [id])
}

model CompOffCredit {
  id            String      @id @default(cuid())
  employeeId    String
  attendanceId  String?
  dateEarned    DateTime    @db.Date
  daysEarned    Float
  hoursWorked   Float?
  reason        String?
  status        String      @default("APPROVED")
  approvedById  String?
  expiryDate    DateTime?   @db.Date
  usedDays      Float       @default(0)
  remainingDays Float       @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendance Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([dateEarned])
}

model TimeOffLedger {
  id            String      @id @default(cuid())
  employeeId    String
  timeOffTypeId String
  type          String
  amount        Float
  balanceAfter  Float?
  referenceId   String?
  description   String
  createdById   String?
  createdAt     DateTime    @default(now())

  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timeOffType TimeOffType @relation(fields: [timeOffTypeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([timeOffTypeId])
  @@index([createdAt])
}

model SalaryStructure {
  id            String          @id @default(cuid())
  name          String          @unique
  code          String          @unique
  description   String?
  status        StructureStatus @default(ACTIVE)
  effectiveFrom DateTime        @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  contracts     Contract[]
  payslips      Payslip[]
  rules         SalaryRule[]
}

model SalaryRule {
  id                 String              @id @default(cuid())
  salaryStructureId  String
  name               String
  code               String
  category           SalaryRuleCategory  @default(EARNING)
  sequence           Int                 @default(0)
  calculationType    RuleCalculationType @default(FIXED_AMOUNT)
  fixedAmount        Decimal?            @db.Decimal(12, 2)
  amountFixed        Decimal?            @db.Decimal(12, 2)
  percentage         Decimal?            @db.Decimal(5, 4)
  amountPercentage   Decimal?            @db.Decimal(5, 4)
  formula            String?
  condition          String?
  conditionType      String?
  conditionValue     Decimal?            @db.Decimal(12, 2)
  baseCode           String?
  roundingRule       String?
  status             RuleStatus          @default(ACTIVE)
  appears_on_payslip Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  salaryStructure    SalaryStructure     @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@unique([salaryStructureId, code])
}

model Payrun {
  id          String      @id @default(cuid())
  name        String
  periodStart DateTime    @db.Date
  periodEnd   DateTime    @db.Date
  state       PayrunState @default(DRAFT)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  payslips    Payslip[]
}

model Payslip {
  id                String           @id @default(cuid())
  payrunId          String
  employeeId        String
  salaryStructureId String?
  state             PayslipState     @default(DRAFT)
  periodStart       DateTime         @db.Date
  periodEnd         DateTime         @db.Date
  basicWage         Decimal          @db.Decimal(12, 2)
  grossWage         Decimal?         @db.Decimal(12, 2)
  netWage           Decimal?         @db.Decimal(12, 2)
  totalDeductions   Decimal?         @db.Decimal(12, 2)
  status            PayslipStatus    @default(DRAFT)
  statusMessage     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  employee          Employee         @relation(fields: [employeeId], references: [id])
  payrun            Payrun           @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  salaryStructure   SalaryStructure? @relation(fields: [salaryStructureId], references: [id])
  lines             PayslipLine[]

  @@unique([payrunId, employeeId])
}

model PayslipLine {
  id        String             @id @default(cuid())
  payslipId String
  name      String
  code      String
  category  SalaryRuleCategory
  quantity  Float              @default(1)
  rate      Decimal            @db.Decimal(12, 2)
  amount    Decimal            @db.Decimal(12, 2)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  payslip   Payslip            @relation(fields: [payslipId], references: [id], onDelete: Cascade)
}

enum Role {
  EMPLOYEE
  HR_MANAGER
  HR_PAYROLL_USER
  HR_PAYROLL_ADMIN
  HR_PAYROLL_MANAGER
  ADMIN
}

enum ContractType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

enum TimeOffStatus {
  DRAFT
  CONFIRMED
  APPROVED
  VALIDATED
  REFUSED
}

enum StructureStatus {
  ACTIVE
  INACTIVE
}

enum RuleStatus {
  ACTIVE
  INACTIVE
}

enum RuleCalculationType {
  FIXED_AMOUNT
  PERCENTAGE
  FORMULA
  EMPLOYEE_BASIC
}

enum SalaryRuleCategory {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
  BASIC
  ALLOWANCE
  GROSS
  NET
}

enum PayrunState {
  DRAFT
  VALIDATING
  VALIDATION_ERROR
  VALIDATED
  COMPUTED
  PAID
  DONE
  CANCELLED
}

enum PayslipState {
  DRAFT
  COMPUTED
  VALIDATED
  PAID
}

enum PayslipStatus {
  DRAFT
  PASSED
  FAILED
  COMPUTED
  LOCKED
}
